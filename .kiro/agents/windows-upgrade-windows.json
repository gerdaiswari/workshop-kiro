{
  "name": "windows-upgrade-windows",
  "description": "Windows-workstation version of the workshop agent, using the py -3 launcher for scripts and hooks.",
  "prompt": "You are the workshop Windows upgrade engineer running from a Windows workstation. Follow workspace steering and the windows-upgrade skill. Use the py -3 launcher for Python commands. Treat AWS mutations as human-approved changes. Prefer AWS-owned runbooks, clone-based validation, deterministic tests, and captured evidence. Never claim that an AMI clone synchronizes live databases or guarantees zero downtime. Do not start upgrades, switch targets, or delete resources without explicit approval in the current user turn.",
  "tools": [
    "read",
    "write",
    "grep",
    "glob",
    "code",
    "shell",
    "use_aws",
    "subagent",
    "@aws-knowledge-mcp-server/*"
  ],
  "allowedTools": [
    "read",
    "grep",
    "glob",
    "code",
    "@aws-knowledge-mcp-server/*"
  ],
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "./scripts/**",
        "./tests/**",
        "./apps/**",
        "./infra/**",
        "./inventory/**",
        "./results/**",
        "./docs/**",
        "./modules/**",
        "./.kiro/specs/**"
      ],
      "deniedPaths": [
        "./results/**/secrets*",
        "./.env",
        "./**/*.pem"
      ]
    },
    "shell": {
      "allowedCommands": [
        "py -3 tests/static/validate_repo.py*",
        "py -3 scripts/01_collect_inventory.py*",
        "py -3 scripts/02_analyze_compatibility.py*",
        "py -3 scripts/03_run_tests.py*",
        "aws sts get-caller-identity*",
        "aws cloudformation describe-*",
        "aws ec2 describe-*",
        "aws ssm describe-*",
        "aws ssm get-*",
        "aws ssm list-*",
        "git status*",
        "git diff*"
      ],
      "deniedCommands": [
        "aws ec2 terminate-instances*",
        "aws cloudformation delete-stack*",
        "aws ec2 delete-snapshot*",
        "aws ec2 deregister-image*",
        "Remove-Item * -Recurse*"
      ],
      "autoAllowReadonly": true,
      "denyByDefault": false
    },
    "use_aws": {
      "allowedServices": [
        "ec2",
        "ssm",
        "cloudformation",
        "elasticloadbalancingv2",
        "sts"
      ],
      "autoAllowReadonly": true
    }
  },
  "hooks": {
    "preToolUse": [
      {
        "matcher": "shell",
        "command": "py -3 scripts\\hooks\\block_destructive.py",
        "timeout_ms": 10000
      }
    ],
    "postToolUse": [
      {
        "matcher": "write",
        "command": "py -3 tests\\static\\validate_repo.py --quick",
        "timeout_ms": 30000
      }
    ]
  },
  "mcpServers": {
    "aws-knowledge-mcp-server": {
      "url": "https://knowledge-mcp.global.api.aws",
      "timeout": 120000
    }
  },
  "resources": [
    "file://README.md",
    "file://inventory/assumed-inventory.yaml",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "welcomeMessage": "Windows-workstation upgrade agent ready. I use py -3 and require approval before AWS mutations."
}
