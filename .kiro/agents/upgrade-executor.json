{
  "name": "upgrade-executor",
  "description": "Fast execution agent for routine tasks. Uses a lightweight model to minimize cost on simple tasks.",
  "model": "claude-haiku-4.5",
  "prompt": "You are a workshop execution assistant. You run predefined scripts, collect outputs, format results, and report status. You do NOT make architectural decisions or approve AWS mutations. When a task requires judgment or planning, escalate to the reviewer. Keep responses concise and factual.",
  "tools": [
    "read",
    "write",
    "grep",
    "glob",
    "shell",
    "use_aws"
  ],
  "allowedTools": [
    "read",
    "grep",
    "glob"
  ],
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "./results/**",
        "./inventory/**"
      ],
      "deniedPaths": [
        "./**/*.pem",
        "./.env",
        "./**/secrets*"
      ]
    },
    "shell": {
      "allowedCommands": [
        "python3 tests/static/validate_repo.py*",
        "python3 scripts/01_collect_inventory.py*",
        "python3 scripts/03_run_tests.py*",
        "python3 scripts/06_compare_results.py*",
        "aws sts get-caller-identity*",
        "aws cloudformation describe-*",
        "aws ec2 describe-*",
        "aws ssm describe-*",
        "aws ssm get-command-invocation*",
        "aws s3 ls*",
        "aws s3 cp*"
      ],
      "deniedCommands": [
        "aws ec2 terminate-instances*",
        "aws cloudformation delete-stack*",
        "rm -rf *"
      ],
      "autoAllowReadonly": true,
      "denyByDefault": false
    },
    "use_aws": {
      "allowedServices": ["ec2", "ssm", "cloudformation", "s3", "sts"],
      "autoAllowReadonly": true
    }
  },
  "resources": [
    "file://results/deployment/state.json"
  ],
  "welcomeMessage": "Executor ready. I run scripts, collect results, and report. What task should I execute?"
}
